# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (legacy service_role JWT or new sb_secret_... key). Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables live AI enrichment. Leave blank to use labeled preview (mock) outputs.
OPENAI_API_KEY=
# Required for live AI: the passcode users type. Live AI stays off while this is blank.
AI_PASSCODE=
# Optional: models (both default to gpt-5.4-mini)
AI_MODEL_TEXT=
AI_MODEL_VISION=
# Optional: live AI runs per day across the site (default 20)
AI_DAILY_LIMIT=

# Optional: override the scraper's User-Agent (default: XenFloBot/1.0)
SCRAPER_USER_AGENT=
