# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (legacy service_role JWT or new sb_secret_... key). Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables live AI enrichment. Leave blank to use labeled mock outputs.
OPENAI_API_KEY=

# Optional: override the scraper's User-Agent (default: XenFloBot/1.0)
SCRAPER_USER_AGENT=
